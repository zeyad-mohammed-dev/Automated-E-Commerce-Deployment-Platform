NODE_ENV=development

# gRPC port (Charge, used by checkoutservice) and REST port (used by the gateway and Stripe)
PORT=50051
HTTP_PORT=8080

REDIS_URL=redis://127.0.0.1:6379
INTERNAL_API_KEY=

# mock   = a fake pay page inside the website, no keys and no internet needed (default)
# stripe = Stripe Checkout in TEST mode (use a sk_test_ key and the 4242 4242 4242 4242 test card)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
# the whsec_ secret of the webhook endpoint (Stripe dashboard, or "stripe listen" in development)
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com

# Public address of the website, the customer comes back here after paying
FRONTEND_URL=http://localhost:4200
# The gateway endpoint that creates the order as soon as the payment is confirmed (optional)
PAID_CALLBACK_URL=http://gateway:8080/internal/payments/paid

# how long an unpaid payment is kept (seconds)
INTENT_TTL=7200
