NODE_ENV=development
PORT=8080

# Same name as before. Use the plain postgres url (no +psycopg2 part anymore)
DATABASE_URL=postgresql://shopora:shopora@127.0.0.1:5432/orders
# Set to true for RDS (ssl on, certificate not verified)
DATABASE_SSL=false

# Used to restock / count sales and to read product names
CATALOG_SERVICE_URL=http://productcatalogservice:8080
# When set, every route except POST /api/orders needs the x-internal-key header
INTERNAL_API_KEY=
