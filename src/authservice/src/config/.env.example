NODE_ENV=development
PORT=8080

DB_URI=mongodb://127.0.0.1:27017/shopora-auth
REDIS_URL=redis://127.0.0.1:6379

# The same secret must be set in the gateway
JWT_SECRET=change-me
# token life in seconds (default 7 days)
ACCESS_TOKEN_TTL=604800
OTP_TTL=600

# OTP emails. If SMTP_HOST is empty the OTP is only printed in the log (development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Shopora <no-reply@shopora.com>"

# The first admin is created at startup if it does not exist
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
