NODE_ENV=development
PORT=8080

REDIS_URL=redis://127.0.0.1:6379
# must be the same as in authservice
JWT_SECRET=change-me
# sent to catalog, orders and payment as x-internal-key (the same value must be set there)
INTERNAL_API_KEY=

# REST services
AUTH_SERVICE_URL=http://authservice:8080
CATALOG_SERVICE_URL=http://productcatalogservice:8080
SEARCH_SERVICE_URL=http://searchservice:8080
ORDERS_SERVICE_URL=http://ordersservice:8080
PAYMENT_SERVICE_URL=http://paymentservice:8080

# gRPC services (the original ones)
CART_SERVICE_ADDR=cartservice:7070
CHECKOUT_SERVICE_ADDR=checkoutservice:5050
SHIPPING_SERVICE_ADDR=shippingservice:50051
CURRENCY_SERVICE_ADDR=currencyservice:7000
RECOMMENDATION_SERVICE_ADDR=recommendationservice:8080

STORE_CURRENCY=EGP
