NODE_ENV=development

# gRPC port (same contract as the original Go catalog) and REST port
PORT=3550
HTTP_PORT=8080

DB_URI=mongodb://127.0.0.1:27017/shopora-catalog
REDIS_URL=redis://127.0.0.1:6379

# Prices are stored in STORE_CURRENCY. The gRPC contract returns price_usd,
# so the rate is read from currencyservice (cached for CURRENCY_RATE_TTL seconds).
STORE_CURRENCY=EGP
CURRENCY_SERVICE_ADDR=currencyservice:7000
CURRENCY_RATE_TTL=600

# Image storage: local | s3 (s3 uses the default AWS credentials chain)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=
S3_PUBLIC_BASE_URL=

# Optional shared secret. When set, write/internal routes need the x-internal-key header
INTERNAL_API_KEY=

CATALOG_EVENTS_CHANNEL=catalog.events
