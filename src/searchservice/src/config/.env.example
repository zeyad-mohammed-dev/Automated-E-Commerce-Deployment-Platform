NODE_ENV=development
PORT=8080

DB_URI=mongodb://127.0.0.1:27017/shopora-search
REDIS_URL=redis://127.0.0.1:6379

# Where the first sync comes from, and the shared secret for its internal routes
CATALOG_SERVICE_URL=http://productcatalogservice:8080
INTERNAL_API_KEY=

# Pub/sub messages can be missed, so the whole catalog is synced again every N seconds (0 = off)
SYNC_INTERVAL_SECONDS=300
CATALOG_EVENTS_CHANNEL=catalog.events
