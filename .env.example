# Copy this file to ".env" (cp .env.example .env) and change the values.
# docker compose reads ".env" by itself. Never put ".env" in Git.

# ---- secrets (change them!) ----
# signs the login tokens (gateway and authservice must have the same value)
JWT_SECRET=change-this-long-random-text
# the services use it to talk to each other
INTERNAL_API_KEY=change-this-other-random-text
POSTGRES_PASSWORD=change-this-db-password

# ---- first admin account (created when authservice starts) ----
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@shopora.com
# at least 8 characters, with a letter and a number
ADMIN_PASSWORD=ChangeMe123

# ---- the address people use in the browser ----
# the payment page sends the customer back here
PUBLIC_URL=http://localhost:8080

# ---- emails with the OTP code ----
# leave SMTP_HOST empty in development: the code is printed in the log of authservice
# (docker compose logs authservice)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Shopora <no-reply@shopora.com>

# ---- payment ----
# mock   = a fake pay page, no keys needed
# stripe = Stripe in TEST mode
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- product pictures ----
# local = saved in a Docker volume (fine for one machine)
# s3    = saved in AWS S3 (then fill the S3_ values)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- image version used in the image names (shopora/gateway:1.0) ----
TAG=1.0
